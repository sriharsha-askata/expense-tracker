# Proposed local configuration for Phase 3. Not used in this discovery phase.
# Copy to .env, which is git-ignored. Put no real secrets and no financial data here.
# The values below are placeholders for a laptop database, not credentials for any deployed system.

APP_ENV=local
POSTGRES_USER=expense
POSTGRES_PASSWORD=local-dev-change-me
POSTGRES_DB=expense
DATABASE_URL=postgresql+psycopg://expense:local-dev-change-me@localhost:5432/expense

# Generate a long random string in Phase 3. Do not reuse this placeholder.
SESSION_SECRET=replace-with-a-long-random-string

# AI is off until Phase 5 and until the Product Owner accepts the disclosure.
AI_PROVIDER=none
GROK_API_KEY=
GROK_API_BASE_URL=
GROK_MODEL=
